<Window x:Class="OrSend.ClientDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="orSend 客户端"
        Width="1120" Height="720" MinWidth="940" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display"
        WindowStyle="None"
        ResizeMode="CanResize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- 顶栏 -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="&#xE968;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="orSend" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Margin="10,0,0,0" />
                        <Border Background="#F1F3F6" CornerRadius="5" Padding="6,2" Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="客户端" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                        </Border>
                        <TextBlock Text="{Binding VersionText}" FontSize="11.5" VerticalAlignment="Center"
                                   Foreground="{StaticResource FaintBrush}" Margin="10,0,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{Binding StateWeakBrush}" CornerRadius="20" Padding="10,4"
                                Margin="0,0,12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{Binding StateBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StateText}" FontSize="12" Margin="6,0,0,0"
                                           Foreground="{Binding StateBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Button Content="连接" Style="{StaticResource BtnPrimary}" Width="72" Height="30"
                                Margin="0,0,8,0" Command="{Binding ConnectCommand}"
                                Visibility="{Binding EngineOnline, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                                WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button Content="断开" Style="{StaticResource Btn}" Width="72" Height="30"
                                Margin="0,0,8,0" Command="{Binding DisconnectCommand}"
                                Visibility="{Binding EngineOnline, Converter={StaticResource BoolVis}}"
                                WindowChrome.IsHitTestVisibleInChrome="True" />

                        <Border Width="1" Background="{StaticResource BorderBrush}" Margin="4,10,4,10" />

                        <Button Content="&#xE921;" Style="{StaticResource TitleButton}" Click="OnMinimize"
                                WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button Content="&#xE922;" Style="{StaticResource TitleButton}" Click="OnMaximize"
                                WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button Content="&#xE8BB;" Style="{StaticResource TitleButtonClose}" Click="OnClose"
                                WindowChrome.IsHitTestVisibleInChrome="True" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListBox Grid.Row="0" Margin="0,10,0,0" Style="{StaticResource NavList}"
                                 ItemsSource="{Binding NavItems}" SelectedValuePath="Key"
                                 SelectedValue="{Binding SelectedTab, Mode=TwoWay}"
                                 DisplayMemberPath="Title" />

                        <Border Grid.Row="1" Margin="14,0,14,14" Padding="12" CornerRadius="8"
                                Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="内网目标" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="{Binding TunnelSummary}" FontSize="11.5" Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">

                    <!-- 概览 -->
                    <Grid Margin="22,20,22,20"
                          Visibility="{Binding SelectedTab, Converter={StaticResource TabVis}, ConverterParameter=overview}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="概览" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="本机 agent 与服务端的连接情况" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                        </StackPanel>

                        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14">
                            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding StatState}" Style="{StaticResource MetricValue}"
                                               Foreground="{Binding StateBrush}" />
                                    <TextBlock Text="连接状态" Style="{StaticResource MetricLabel}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding StatTunnels}" Style="{StaticResource MetricValue}" />
                                    <TextBlock Text="已注册隧道" Style="{StaticResource MetricLabel}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding StatStreams}" Style="{StaticResource MetricValue}" />
                                    <TextBlock Text="活跃连接" Style="{StaticResource MetricLabel}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding StatUptime}" Style="{StaticResource MetricValue}" />
                                    <TextBlock Text="在线时长" Style="{StaticResource MetricLabel}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="连接信息" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="30" />
                                            <RowDefinition Height="30" />
                                            <RowDefinition Height="30" />
                                            <RowDefinition Height="30" />
                                            <RowDefinition Height="30" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="服务端" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InfoServer}" Style="{StaticResource Mono}" VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="1" Text="客户端 ID" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InfoClientId}" Style="{StaticResource Mono}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Row="2" Text="显示名称" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InfoName}" VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="3" Text="控制端口" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding InfoControlPort}" Style="{StaticResource Mono}" VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="4" Text="最近错误" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding InfoLastError}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource DangerBrush}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="最近事件" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding RecentEvents}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="56" />
                                                        <ColumnDefinition Width="44" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Time}" Style="{StaticResource Mono}"
                                                               Foreground="{StaticResource FaintBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Level}" FontSize="10.5"
                                                               FontWeight="SemiBold" Foreground="{Binding LevelBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="12"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- 隧道 -->
                    <Grid Margin="22,20,22,20"
                          Visibility="{Binding SelectedTab, Converter={StaticResource TabVis}, ConverterParameter=tunnels}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="隧道" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="把本机端口映射到服务端的公网端口，公网用户访问公网端口即可到达内网服务"
                                       Style="{StaticResource Muted}" Margin="0,4,0,0" />
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="隧道名" Style="{StaticResource Muted}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="本地地址" Style="{StaticResource Muted}" />
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="本地端口" Style="{StaticResource Muted}" />
                                <TextBlock Grid.Row="0" Grid.Column="6" Text="公网端口（0=自动）" Style="{StaticResource Muted}" />

                                <TextBox Grid.Row="2" Grid.Column="0" Style="{StaticResource InputBox}"
                                         Text="{Binding NewTunnelName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Row="2" Grid.Column="2" Style="{StaticResource InputBox}"
                                         Text="{Binding NewTunnelHost, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Row="2" Grid.Column="4" Style="{StaticResource InputBox}"
                                         Text="{Binding NewTunnelLocalPort, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Row="2" Grid.Column="6" Style="{StaticResource InputBox}"
                                         Text="{Binding NewTunnelRemotePort, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Row="2" Grid.Column="8" Content="添加隧道" Style="{StaticResource BtnPrimary}" Width="90"
                                        Command="{Binding AddTunnelCommand}" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                            <DataGrid ItemsSource="{Binding Tunnels}" Style="{StaticResource DataTable}" Margin="6,6,6,8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="隧道名" Binding="{Binding Name}" Width="110" />
                                    <DataGridTextColumn Header="内网目标" Binding="{Binding Target}" Width="150" />
                                    <DataGridTextColumn Header="公网端口" Binding="{Binding PublicPort}" Width="85" />
                                    <DataGridTemplateColumn Header="状态" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <TextBlock Text="已注册" Foreground="{StaticResource SuccessBrush}"
                                                               Visibility="{Binding Registered, Converter={StaticResource BoolVis}}" />
                                                    <TextBlock Text="未注册" Foreground="{StaticResource MutedBrush}"
                                                               Visibility="{Binding Registered, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="累计连接" Binding="{Binding Connections}" Width="80" />
                                    <DataGridTextColumn Header="最近错误" Binding="{Binding LastError}" Width="*" />
                                    <DataGridTemplateColumn Header="" Width="Auto" MinWidth="64">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="删除" Style="{StaticResource BtnLink}"
                                                        Foreground="{StaticResource DangerBrush}"
                                                        Command="{Binding DataContext.RemoveTunnelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>

                    <!-- 日志 -->
                    <Grid Margin="22,20,22,20"
                          Visibility="{Binding SelectedTab, Converter={StaticResource TabVis}, ConverterParameter=logs}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="运行日志" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="来自 agent 的实时日志，最多保留 500 条" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <CheckBox Content="自动滚动" Style="{StaticResource InputCheck}" IsChecked="{Binding AutoScroll}"
                                          VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Button Content="清空" Style="{StaticResource Btn}" Width="64" Command="{Binding ClearLogsCommand}" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Margin="6,8,6,8">
                                <ItemsControl ItemsSource="{Binding Logs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="6,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="62" />
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="66" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Time}" Style="{StaticResource Mono}"
                                                           Foreground="{StaticResource FaintBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Level}" FontSize="10.5"
                                                           FontWeight="SemiBold" Foreground="{Binding LevelBrush}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Tag}" Style="{StaticResource Mono}"
                                                           Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock Grid.Column="3" Text="{Binding Message}" Style="{StaticResource Mono}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- 设置 -->
                    <Grid Margin="22,20,22,20"
                          Visibility="{Binding SelectedTab, Converter={StaticResource TabVis}, ConverterParameter=settings}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="设置" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="修改后需要重启 agent 才会生效" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="服务端地址" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                                    <TextBox Style="{StaticResource InputBox}" Text="{Binding SettingServer, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="接入口令（token）" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                                    <TextBox Style="{StaticResource InputBox}" Text="{Binding SettingToken, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="客户端 ID" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                                    <TextBox Style="{StaticResource InputBox}" Text="{Binding SettingClientId, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Text="显示名称" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                                    <TextBox Style="{StaticResource InputBox}" Text="{Binding SettingName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Row="4" Grid.Column="0">
                                    <TextBlock Text="控制接口端口" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                                    <TextBox Style="{StaticResource InputBox}" Text="{Binding SettingControlPort, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="4" Grid.Column="2">
                                    <TextBlock Text="日志级别" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                                    <ComboBox Style="{StaticResource InputCombo}" ItemsSource="{Binding LogLevels}"
                                              SelectedItem="{Binding SettingLogLevel}" />
                                </StackPanel>

                                <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal">
                                    <Button Content="保存并重连" Style="{StaticResource BtnPrimary}" Width="120"
                                            Command="{Binding SaveSettingsCommand}" />
                                    <CheckBox Content="启动程序时自动连接" Style="{StaticResource InputCheck}"
                                              IsChecked="{Binding SettingAutoConnect}" VerticalAlignment="Center" Margin="16,0,0,0" />
                                    <TextBlock Text="{Binding SettingsHint}" Style="{StaticResource Muted}"
                                               VerticalAlignment="Center" Margin="12,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="引擎进程输出" Style="{StaticResource SectionTitle}" Margin="16,14,16,6" />
                                <TextBox Grid.Row="1" Text="{Binding EngineOutput}" IsReadOnly="True" BorderThickness="0"
                                         Background="Transparent" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                         Foreground="{StaticResource MutedBrush}" Margin="12,0,12,10"
                                         VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                                         VerticalContentAlignment="Top" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- 状态栏 -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusBar}" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusRight}" FontSize="11.5"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
