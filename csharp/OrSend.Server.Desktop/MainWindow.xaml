<Window x:Class="OrSend.ServerDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="orSend 服务端控制台"
        Width="1160" Height="740" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display"
        WindowStyle="None"
        ResizeMode="CanResize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- ============ 顶栏 ============ -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="&#xE968;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="orSend" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Margin="10,0,0,0" />
                        <Border Background="#F1F3F6" CornerRadius="5" Padding="6,2" Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="服务端" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                        </Border>
                        <TextBlock Text="{Binding VersionText}" FontSize="11.5" VerticalAlignment="Center"
                                   Foreground="{StaticResource FaintBrush}" Margin="10,0,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{Binding StateWeakBrush}" CornerRadius="20" Padding="10,4"
                                Margin="0,0,12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{Binding StateBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StateText}" FontSize="12" Margin="6,0,0,0"
                                           Foreground="{Binding StateBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Button Content="启动" Style="{StaticResource BtnPrimary}" Width="72" Height="30"
                                Margin="0,0,8,0" Command="{Binding StartCommand}"
                                Visibility="{Binding EngineOnline, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                                WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button Content="停止" Style="{StaticResource Btn}" Width="72" Height="30"
                                Margin="0,0,8,0" Command="{Binding StopCommand}"
                                Visibility="{Binding EngineOnline, Converter={StaticResource BoolVis}}"
                                WindowChrome.IsHitTestVisibleInChrome="True" />

                        <Border Width="1" Background="{StaticResource BorderBrush}" Margin="4,10,4,10" />

                        <Button Content="&#xE921;" Style="{StaticResource TitleButton}" Click="OnMinimize"
                                WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button Content="&#xE922;" Style="{StaticResource TitleButton}" Click="OnMaximize"
                                WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button Content="&#xE8BB;" Style="{StaticResource TitleButtonClose}" Click="OnClose"
                                WindowChrome.IsHitTestVisibleInChrome="True" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ 主体 ============ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="192" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧导航 -->
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListBox Grid.Row="0" Margin="0,10,0,0" Style="{StaticResource NavList}"
                                 ItemsSource="{Binding NavItems}" SelectedValuePath="Key"
                                 SelectedValue="{Binding SelectedTab, Mode=TwoWay}"
                                 DisplayMemberPath="Title" />

                        <Border Grid.Row="1" Margin="14,0,14,14" Padding="12" CornerRadius="8"
                                Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="引擎进程" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="{Binding ExeName}" FontSize="11.5" Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding ExePath}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 内容区 -->
                <Grid Grid.Column="1">

                    <!-- ===== 概览 ===== -->
                    <Grid Margin="22,20,22,20"
                          Visibility="{Binding SelectedTab, Converter={StaticResource TabVis}, ConverterParameter=overview}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="概览" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="内网穿透服务端的实时运行情况" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                        </StackPanel>

                        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14">
                            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding StatAgents}" Style="{StaticResource MetricValue}" />
                                    <TextBlock Text="在线客户端" Style="{StaticResource MetricLabel}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding StatTunnels}" Style="{StaticResource MetricValue}" />
                                    <TextBlock Text="已注册隧道" Style="{StaticResource MetricLabel}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding StatStreams}" Style="{StaticResource MetricValue}" />
                                    <TextBlock Text="活跃连接" Style="{StaticResource MetricLabel}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding StatTraffic}" Style="{StaticResource MetricValue}" />
                                    <TextBlock Style="{StaticResource MetricLabel}">
                                        <Run Text="累计流量 ↑" /><Run Text="{Binding TrafficUp, Mode=OneWay}" /><Run Text=" / ↓" /><Run Text="{Binding TrafficDown, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="运行信息" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="30" />
                                            <RowDefinition Height="30" />
                                            <RowDefinition Height="30" />
                                            <RowDefinition Height="30" />
                                            <RowDefinition Height="30" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="接入地址" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InfoBind}" Style="{StaticResource Mono}" VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="1" Text="公网监听" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InfoPublicHost}" Style="{StaticResource Mono}" VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="2" Text="控制端口" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InfoControlPort}" Style="{StaticResource Mono}" VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="3" Text="运行时长" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding InfoUptime}" VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="4" Text="认证口令" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding InfoToken}" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="最近事件" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding RecentEvents}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="56" />
                                                        <ColumnDefinition Width="44" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Time}" Style="{StaticResource Mono}"
                                                               Foreground="{StaticResource FaintBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Level}" FontSize="10.5"
                                                               FontWeight="SemiBold" Foreground="{Binding LevelBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="12"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ===== 客户端与隧道 ===== -->
                    <Grid Margin="22,20,22,20"
                          Visibility="{Binding SelectedTab, Converter={StaticResource TabVis}, ConverterParameter=agents}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="客户端与隧道" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="接入的 agent 会话，以及每个 agent 注册的公网端口" Style="{StaticResource Muted}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="接入的客户端" Style="{StaticResource SectionTitle}" Margin="16,14,16,6" />
                                <DataGrid ItemsSource="{Binding Agents}" Style="{StaticResource DataTable}"
                                          MaxHeight="230" Margin="6,0,6,8">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="客户端 ID" Binding="{Binding ClientId}" Width="150" />
                                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn Header="来源地址" Binding="{Binding RemoteAddr}" Width="140" />
                                        <DataGridTextColumn Header="隧道" Binding="{Binding Tunnels.Count}" Width="50" />
                                        <DataGridTextColumn Header="连接数" Binding="{Binding StreamsTotal}" Width="60" />
                                        <DataGridTextColumn Header="在线时长" Binding="{Binding UptimeSec, Converter={StaticResource Dur}}" Width="80" />
                                        <DataGridTextColumn Header="上行" Binding="{Binding BytesIn, Converter={StaticResource Bytes}}" Width="70" />
                                        <DataGridTextColumn Header="下行" Binding="{Binding BytesOut, Converter={StaticResource Bytes}}" Width="70" />
                                        <DataGridTemplateColumn Header="" Width="Auto" MinWidth="72">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="踢下线" Style="{StaticResource BtnLink}"
                                                            Command="{Binding DataContext.KickAgentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="公网隧道" Style="{StaticResource SectionTitle}" Margin="16,14,16,6" />
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Tunnels}" Style="{StaticResource DataTable}"
                                          Margin="6,0,6,8">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="隧道名" Binding="{Binding Name}" Width="110" />
                                        <DataGridTextColumn Header="客户端" Binding="{Binding ClientId}" Width="150" />
                                        <DataGridTextColumn Header="公网端口" Binding="{Binding PublicPort}" Width="80" />
                                        <DataGridTextColumn Header="内网目标" Binding="{Binding Target}" Width="150" />
                                        <DataGridTextColumn Header="活跃" Binding="{Binding ActiveStreams}" Width="55" />
                                        <DataGridTextColumn Header="累计连接" Binding="{Binding Connections}" Width="80" />
                                        <DataGridTextColumn Header="上行" Binding="{Binding BytesIn, Converter={StaticResource Bytes}}" Width="70" />
                                        <DataGridTextColumn Header="下行" Binding="{Binding BytesOut, Converter={StaticResource Bytes}}" Width="70" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ===== 转发规则 ===== -->
                    <Grid Margin="22,20,22,20"
                          Visibility="{Binding SelectedTab, Converter={StaticResource TabVis}, ConverterParameter=forward}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="端口转发" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="单目标 TCP 转发，监听端口进来的连接直接转到目标地址" Style="{StaticResource Muted}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="规则名（可留空）" Style="{StaticResource Muted}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="监听地址，如 0.0.0.0:8080" Style="{StaticResource Muted}" />
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="目标地址，如 127.0.0.1:80" Style="{StaticResource Muted}" />

                                <TextBox Grid.Row="2" Grid.Column="0" Style="{StaticResource InputBox}"
                                         Text="{Binding NewForwardName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Row="2" Grid.Column="2" Style="{StaticResource InputBox}"
                                         Text="{Binding NewForwardListen, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Row="2" Grid.Column="4" Style="{StaticResource InputBox}"
                                         Text="{Binding NewForwardTarget, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Row="2" Grid.Column="6" Content="添加规则" Style="{StaticResource BtnPrimary}" Width="90"
                                        Command="{Binding AddForwardCommand}" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                            <DataGrid ItemsSource="{Binding ForwardRules}" Style="{StaticResource DataTable}" Margin="6,6,6,8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="规则名" Binding="{Binding Name}" Width="130" />
                                    <DataGridTextColumn Header="监听" Binding="{Binding Listen}" Width="150" />
                                    <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="160" />
                                    <DataGridTextColumn Header="活跃" Binding="{Binding Active}" Width="55" />
                                    <DataGridTextColumn Header="累计连接" Binding="{Binding Connections}" Width="80" />
                                    <DataGridTextColumn Header="失败" Binding="{Binding Failed}" Width="55" />
                                    <DataGridTextColumn Header="上行" Binding="{Binding BytesIn, Converter={StaticResource Bytes}}" Width="70" />
                                    <DataGridTextColumn Header="下行" Binding="{Binding BytesOut, Converter={StaticResource Bytes}}" Width="70" />
                                    <DataGridTemplateColumn Header="" Width="Auto" MinWidth="64">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="删除" Style="{StaticResource BtnLink}"
                                                        Foreground="{StaticResource DangerBrush}"
                                                        Command="{Binding DataContext.RemoveForwardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>

                    <!-- ===== 映射规则 ===== -->
                    <Grid Margin="22,20,22,20"
                          Visibility="{Binding SelectedTab, Converter={StaticResource TabVis}, ConverterParameter=mapping}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="端口映射" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="一个监听端口对应多个后端目标，支持轮询 / 最少连接 / 随机 / 故障转移" Style="{StaticResource Muted}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="1.7*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="规则名（可留空）" Style="{StaticResource Muted}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="监听地址" Style="{StaticResource Muted}" />
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="目标列表，逗号分隔" Style="{StaticResource Muted}" />
                                <TextBlock Grid.Row="0" Grid.Column="6" Text="策略" Style="{StaticResource Muted}" />
                                <TextBlock Grid.Row="0" Grid.Column="8" Text="健康检查" Style="{StaticResource Muted}" />

                                <TextBox Grid.Row="2" Grid.Column="0" Style="{StaticResource InputBox}"
                                         Text="{Binding NewMappingName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Row="2" Grid.Column="2" Style="{StaticResource InputBox}"
                                         Text="{Binding NewMappingListen, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Row="2" Grid.Column="4" Style="{StaticResource InputBox}"
                                         Text="{Binding NewMappingTargets, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="如 10.0.0.1:80,10.0.0.2:80" />
                                <ComboBox Grid.Row="2" Grid.Column="6" Width="112" Style="{StaticResource InputCombo}"
                                          ItemsSource="{Binding Strategies}" SelectedItem="{Binding NewMappingStrategy}" />
                                <CheckBox Grid.Row="2" Grid.Column="8" Style="{StaticResource InputCheck}"
                                          IsChecked="{Binding NewMappingHealthCheck}" VerticalAlignment="Center" />
                                <Button Grid.Row="2" Grid.Column="10" Content="添加规则" Style="{StaticResource BtnPrimary}" Width="90"
                                        Command="{Binding AddMappingCommand}" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                            <DataGrid ItemsSource="{Binding MappingRules}" Style="{StaticResource DataTable}" Margin="6,6,6,8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="规则名" Binding="{Binding Name}" Width="130" />
                                    <DataGridTextColumn Header="监听" Binding="{Binding Listen}" Width="150" />
                                    <DataGridTextColumn Header="策略" Binding="{Binding Strategy}" Width="104" />
                                    <DataGridTextColumn Header="目标数" Binding="{Binding Targets.Count}" Width="60" />
                                    <DataGridTextColumn Header="活跃" Binding="{Binding Active}" Width="55" />
                                    <DataGridTextColumn Header="累计连接" Binding="{Binding Connections}" Width="80" />
                                    <DataGridTextColumn Header="失败" Binding="{Binding Failed}" Width="55" />
                                    <DataGridTextColumn Header="上行" Binding="{Binding BytesIn, Converter={StaticResource Bytes}}" Width="70" />
                                    <DataGridTextColumn Header="下行" Binding="{Binding BytesOut, Converter={StaticResource Bytes}}" Width="70" />
                                    <DataGridTemplateColumn Header="" Width="Auto" MinWidth="64">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="删除" Style="{StaticResource BtnLink}"
                                                        Foreground="{StaticResource DangerBrush}"
                                                        Command="{Binding DataContext.RemoveMappingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>

                    <!-- ===== 日志 ===== -->
                    <Grid Margin="22,20,22,20"
                          Visibility="{Binding SelectedTab, Converter={StaticResource TabVis}, ConverterParameter=logs}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="运行日志" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="来自引擎的实时日志，最多保留 500 条" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <CheckBox Content="自动滚动" Style="{StaticResource InputCheck}" IsChecked="{Binding AutoScroll}"
                                          VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Button Content="清空" Style="{StaticResource Btn}" Width="64" Command="{Binding ClearLogsCommand}" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Margin="6,8,6,8">
                                <ItemsControl ItemsSource="{Binding Logs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="6,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="62" />
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="66" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Time}" Style="{StaticResource Mono}"
                                                           Foreground="{StaticResource FaintBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Level}" FontSize="10.5"
                                                           FontWeight="SemiBold" Foreground="{Binding LevelBrush}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Tag}" Style="{StaticResource Mono}"
                                                           Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock Grid.Column="3" Text="{Binding Message}" Style="{StaticResource Mono}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- ===== 设置 ===== -->
                    <Grid Margin="22,20,22,20"
                          Visibility="{Binding SelectedTab, Converter={StaticResource TabVis}, ConverterParameter=settings}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="设置" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="修改后需要重启引擎才会生效，规则会自动重新灌入" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="agent 接入地址" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                                    <TextBox Style="{StaticResource InputBox}" Text="{Binding SettingBind, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="公网监听地址" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                                    <TextBox Style="{StaticResource InputBox}" Text="{Binding SettingPublicHost, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="接入口令（token）" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                                    <TextBox Style="{StaticResource InputBox}" Text="{Binding SettingToken, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Text="控制接口端口" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                                    <TextBox Style="{StaticResource InputBox}" Text="{Binding SettingControlPort, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Row="4" Grid.Column="0">
                                    <TextBlock Text="日志级别" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                                    <ComboBox Style="{StaticResource InputCombo}" ItemsSource="{Binding LogLevels}"
                                              SelectedItem="{Binding SettingLogLevel}" />
                                </StackPanel>
                                <StackPanel Grid.Row="4" Grid.Column="2" VerticalAlignment="Bottom">
                                    <CheckBox Content="启动程序时自动启动引擎" Style="{StaticResource InputCheck}"
                                              IsChecked="{Binding SettingAutoStart}" />
                                </StackPanel>

                                <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal">
                                    <Button Content="保存并重启引擎" Style="{StaticResource BtnPrimary}" Width="132"
                                            Command="{Binding SaveSettingsCommand}" />
                                    <TextBlock Text="{Binding SettingsHint}" Style="{StaticResource Muted}"
                                               VerticalAlignment="Center" Margin="12,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="引擎进程输出" Style="{StaticResource SectionTitle}" Margin="16,14,16,6" />
                                <TextBox Grid.Row="1" Text="{Binding EngineOutput}" IsReadOnly="True" BorderThickness="0"
                                         Background="Transparent" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                         Foreground="{StaticResource MutedBrush}" Margin="12,0,12,10"
                                         VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                                         VerticalContentAlignment="Top" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ============ 状态栏 ============ -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusBar}" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusRight}" FontSize="11.5"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
