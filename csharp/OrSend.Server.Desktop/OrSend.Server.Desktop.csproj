<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>OrSend.Server.Desktop</AssemblyName>
    <RootNamespace>OrSend.ServerDesktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OrSend.Shared\OrSend.Shared.csproj" />
    <ProjectReference Include="..\OrSend.Desktop.Common\OrSend.Desktop.Common.csproj" />
  </ItemGroup>

</Project>
